# .gitignore — cold-chain-monitor root

# ── Node ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment (NEVER commit real secrets) ───────────────────
.env
.env.local
.env.*.local

# ── Build outputs ─────────────────────────────────────────────
dist/
build/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/
