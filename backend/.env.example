# Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ─── Server ───────────────────────────────────────────────────
# Host must be 0.0.0.0 so the ESP32 can reach it via LAN IP
HOST=0.0.0.0
PORT=3000

# ─── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=coldchain

# ─── Decay Model ──────────────────────────────────────────────
# Choose Arrhenius (default) or Q10
# Values: arrhenius | q10
DECAY_MODEL=arrhenius

# Maximum time gap (seconds) between readings used in consumption
# calculation. Gaps larger than this are clamped to prevent
# over-counting shelf life during offline periods.
MAX_GAP_S=600

# Number of consecutive readings above VOC threshold required
# before raising SPOILAGE_SUSPECTED alert.
VOC_CONSECUTIVE_N=3

# ─── SSE Keep-alive ───────────────────────────────────────────
# How often (ms) to send a keep-alive comment on SSE streams.
SSE_KEEPALIVE_MS=15000

# ─── Thresholds ───────────────────────────────────────────────
# Seconds since last reading before a device is considered offline.
ONLINE_THRESHOLD_S=30

# Seconds with no reading before DEVICE_OFFLINE alert is raised.
OFFLINE_ALERT_S=120
